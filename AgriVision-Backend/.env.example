DATABASE_URL=postgresql://admin:change-me@db:5432/agrivision
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agrivision
REDIS_URL=redis://redis:6379/0
ENABLE_TIMESCALEDB=true
MAX_REQUEST_BODY_BYTES=1048576
CHAT_REQUEST_MAX_BYTES=33554432
CHAT_GCS_BUCKET=
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
AGROMONITORING_API_KEY=
AGRO_FREE_MODE=true
AGRO_SATELLITE_INTERVAL_HOURS=6
AGRO_SOIL_INTERVAL_HOURS=6
AGRO_WEATHER_INTERVAL_HOURS=6
AGRO_UVI_INTERVAL_HOURS=6
AGRO_INITIAL_SYNC_TIMEOUT_SECONDS=15
AGRO_WORKER_SCAN_SECONDS=300
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_AI_MODEL=gemini-3.5-flash
VERTEX_SEARCH_DATASTORE=
GOOGLE_APPLICATION_CREDENTIALS=/app/google-application-credentials.json
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-credentials.json
FIREBASE_CLOCK_SKEW_SECONDS=5
ALLOWED_ORIGINS=
